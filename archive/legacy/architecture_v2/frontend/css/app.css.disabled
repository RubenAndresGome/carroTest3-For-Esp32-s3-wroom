:root {
  color-scheme: dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  background: #081018;
  color: #e5edf5;
}

* { box-sizing: border-box; }

body {
  min-height: 100vh;
  margin: 0;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(circle at top, rgba(0, 230, 118, 0.10), transparent 34rem),
    #081018;
}

.panel {
  width: min(680px, 100%);
  padding: clamp(22px, 5vw, 42px);
  border: 1px solid #223243;
  border-radius: 18px;
  background: rgba(15, 25, 36, 0.96);
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.36);
}

.eyebrow {
  margin: 0 0 8px;
  color: #00e676;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

h1 { margin: 0 0 24px; font-size: clamp(26px, 5vw, 40px); }
h2 { margin: 0 0 12px; font-size: 16px; }

.status-card {
  display: flex;
  gap: 14px;
  align-items: center;
  padding: 16px;
  border: 1px solid #283b4f;
  border-radius: 12px;
  background: #0a141f;
}

.status-card p { margin: 4px 0 0; color: #91a4b8; }

.status-dot {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #ff3d5a;
  box-shadow: 0 0 14px rgba(255, 61, 90, 0.55);
}

.status-dot.connecting {
  background: #ffb020;
  box-shadow: 0 0 14px rgba(255, 176, 32, 0.55);
}

.status-dot.connected {
  background: #00e676;
  box-shadow: 0 0 14px rgba(0, 230, 118, 0.55);
}

.config-form { margin-top: 22px; }
.config-form label { display: block; margin-bottom: 8px; font-weight: 650; }
.config-form small { display: block; margin-top: 8px; color: #71869b; }

.input-row { display: flex; gap: 10px; }

input,
button {
  min-height: 44px;
  border-radius: 9px;
  font: inherit;
}

input {
  min-width: 0;
  flex: 1;
  border: 1px solid #30475f;
  padding: 0 13px;
  background: #07111b;
  color: #f3f7fb;
}

button {
  border: 0;
  padding: 0 16px;
  background: #00c968;
  color: #03130b;
  font-weight: 800;
  cursor: pointer;
}

button:hover { background: #00e676; }

.instructions {
  margin-top: 26px;
  padding-top: 22px;
  border-top: 1px solid #223243;
  color: #a7b7c7;
}

.instructions ol { margin: 0; padding-left: 22px; }
.instructions li + li { margin-top: 7px; }
code { color: #69e8a7; }

@media (max-width: 560px) {
  .input-row { flex-direction: column; }
  button { width: 100%; }
}
