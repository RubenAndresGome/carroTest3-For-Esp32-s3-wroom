// Diagnostico guiado y aislado del angulo Z (yaw) del MPU6050.
// No usa encoders ni acciona motores. El ESP32 crea una miniweb local y
// mantiene las ocho entradas de los DRV8833 permanentemente en LOW.
// Sin magnetometro, el yaw integrado acumulara deriva lentamente.

#include <Arduino.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <ESPAsyncWebServer.h>
#include <WiFi.h>
#include <Wire.h>
#include "driver/gpio.h"
#include "Config.h"

namespace {

constexpr char RED_AP[] = "PRUEBA_ANGULO_MPU";
constexpr char CLAVE_AP[] = "angulo6050";
constexpr uint32_t PERIODO_IMU_MS = 10;
constexpr uint32_t PERIODO_SERIAL_MS = 500;
constexpr uint32_t EDAD_MAXIMA_LECTURA_MS = 100;
constexpr uint32_t DURACION_VERIFICACION_MS = 500;
constexpr uint32_t DURACION_ESTABILIDAD_MS = 2000;
constexpr uint32_t DURACION_PRUEBA_GIRO_MS = 10000;
constexpr uint32_t MIN_MUESTRAS_CALIBRACION = IMU_CALIBRATION_SAMPLES * 3U / 4U;
constexpr float MAX_GZ_REPOSO_RAD_S = 0.03f;
constexpr float MAX_DERIVA_REPOSO_DEG = 3.0f;
constexpr float MIN_GIRO_PRUEBA_DEG = 30.0f;
constexpr float MIN_GZ_PICO_RAD_S = 0.15f;

enum class EtapaDiagnostico : uint8_t {
    NO_PROBADO,
    ESCANEANDO,
    CALIBRANDO,
    VERIFICANDO_LECTURAS,
    VERIFICANDO_ESTABILIDAD,
    ESPERANDO_GIRO,
    FINALIZADO,
    FALLA,
};

enum class CodigoResultado : uint8_t {
    NO_PROBADO,
    PROBANDO,
    APROBADO,
    SENSOR_FUNCIONAL_ORIENTACION_INVERTIDA,
    BUS_BLOQUEADO,
    MPU_NO_DETECTADO,
    AD0_INCORRECTO,
    IDENTIDAD_INVALIDA,
    CALIBRACION_FALLIDA,
    LECTURAS_OBSOLETAS,
    INESTABLE_EN_REPOSO,
    SIN_RESPUESTA_AL_GIRO,
};

template <size_t N> class PromedioMovil {
public:
    float agregar(float valor) {
        if (cantidad_ < N) {
            valores_[indice_] = valor;
            suma_ += valor;
            ++cantidad_;
        } else {
            suma_ -= valores_[indice_];
            valores_[indice_] = valor;
            suma_ += valor;
        }
        indice_ = (indice_ + 1) % N;
        return suma_ / static_cast<float>(cantidad_);
    }
    void limpiar() {
        for (size_t i = 0; i < N; ++i) valores_[i] = 0.0f;
        indice_ = 0;
        cantidad_ = 0;
        suma_ = 0.0f;
    }
private:
    float valores_[N] = {};
    size_t indice_ = 0;
    size_t cantidad_ = 0;
    float suma_ = 0.0f;
};

constexpr int PINES_MOTOR[] = {
    PIN_FL_FWD, PIN_FL_REV, PIN_FR_FWD, PIN_FR_REV,
    PIN_BL_FWD, PIN_BL_REV, PIN_BR_FWD, PIN_BR_REV,
};

Adafruit_MPU6050 mpu;
AsyncWebServer servidor(80);
PromedioMovil<IMU_GYRO_AVG_WINDOW> filtro_gz;
portMUX_TYPE mux_datos = portMUX_INITIALIZER_UNLOCKED;

EtapaDiagnostico etapa = EtapaDiagnostico::NO_PROBADO;
CodigoResultado codigo_resultado = CodigoResultado::NO_PROBADO;
