constexpr float FACTOR_PWM_DERECHO_MIN = 0.80f;
constexpr float FACTOR_PWM_DERECHO_MAX = 1.00f;
constexpr float FACTOR_PWM_DERECHO_PASO = 0.01f;
constexpr int PWM_CORRECCION_RUMBO_MAX = pwmDesde8Bits(80);
constexpr int PWM_CORRECCION_ENCODER_MAX = pwmDesde8Bits(15);
constexpr float KP_RUMBO_PWM_POR_GRADO = 4.0f * ESCALA_PWM_DESDE_8_BITS;
constexpr float KD_RUMBO_PWM_POR_RAD_S = 12.0f * ESCALA_PWM_DESDE_8_BITS;
constexpr float KP_ENCODER_PWM_POR_TICK = 1.5f * ESCALA_PWM_DESDE_8_BITS;
constexpr float ERROR_RUMBO_ENCODER_MAX_DEG = 2.0f;
constexpr float ERROR_RUMBO_RECUPERAR_DEG = 12.0f;
