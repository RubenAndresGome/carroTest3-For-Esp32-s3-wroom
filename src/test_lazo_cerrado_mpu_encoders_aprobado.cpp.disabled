template <size_t N> class PromedioMovil {
public:
    float agregar(float valor) {
        if (cantidad_ < N) {
            valores_[indice_] = valor;
            suma_ += valor;
            ++cantidad_;
        } else {
            suma_ -= valores_[indice_];
            valores_[indice_] = valor;
            suma_ += valor;
        }
        indice_ = (indice_ + 1) % N;
        return suma_ / static_cast<float>(cantidad_);
    }
    void limpiar() {
        for (float& valor : valores_) valor = 0.0f;
        indice_ = 0;
        cantidad_ = 0;
        suma_ = 0.0f;
    }
private:
    float valores_[N] = {};
    size_t indice_ = 0;
    size_t cantidad_ = 0;
    float suma_ = 0.0f;
};

