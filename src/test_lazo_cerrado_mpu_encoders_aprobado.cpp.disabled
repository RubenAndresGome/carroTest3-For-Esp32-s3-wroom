constexpr uint8_t RESOLUCION_PWM_BITS = 10;
constexpr int PWM_MAX = (1 << RESOLUCION_PWM_BITS) - 1;
constexpr float ESCALA_PWM_DESDE_8_BITS = static_cast<float>(PWM_MAX) / 255.0f;
constexpr int pwmDesde8Bits(int valor) {
    return (valor * PWM_MAX + 127) / 255;
}

constexpr int POLARIDAD_AVANCE = -1;
constexpr int PWM_RECTO_CRUCERO = PWM_MAX;
constexpr int PWM_RECTO_APROXIMACION = pwmDesde8Bits(225);
