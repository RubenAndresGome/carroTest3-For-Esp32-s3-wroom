constexpr float GZ_MOVIMIENTO_RAD_S = 0.12f;
constexpr uint32_t GZ_MOVIMIENTO_SOSTENIDO_MS = 100;
constexpr int64_t TICKS_MOVIMIENTO_CAL = 2;
constexpr int PWM_GIRO_MARGEN_LEJOS = pwmDesde8Bits(25);
constexpr int PWM_GIRO_MARGEN_CERCA = pwmDesde8Bits(8);
constexpr int PWM_GIRO_SLEW_POR_CICLO = pwmDesde8Bits(2);
constexpr int PWM_GIRO_ARRANQUE = (PWM_MAX * 90 + 50) / 100;
